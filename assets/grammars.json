{
	"scopeName": "markdown.custom.injection",
	"injectionSelector": "L:text.html.markdown -comment -markup.raw.block -source",
	"patterns": [
		{
			"name": "constant.numeric.integer.markdown",
			"match": "\\[[a-zA-Zа-яА-ЯёЁ_\\d#]+\\s*[+\\-]?\\s*\\d*\\](?!\\()"
		},
		{
			"name": "constant.other.placeholder.markdown",
			"match": "\\[![a-zA-Zа-яА-ЯёЁ_\\d#]+\\s*[+\\-]?\\s*\\d*\\](?!\\()"
		},
		{
			"match": "^(!!rule|!!section)(\\s+(.+))?\\s*$",
			"captures": {
				"1": {
					"name": "keyword.control.magic.markdown"
				},
				"3": {
					"name": "string.quoted.double.markdown"
				}
			}
		},
		{
			"comment": ":::note[title]{attributes}",
			"name": "meta.admonition.markdown",
			"begin": "^(\\s*)(:{3,})(note|info|tip|warning|danger)(\\[[^\\]]*\\])?(\\{[^}]*\\})?\\s*$",
			"beginCaptures": {
				"2": {
					"name": "punctuation.definition.admonition.markdown"
				},
				"3": {
					"name": "keyword.control.admonition.markdown"
				},
				"4": {
					"name": "string.other.admonition.title.markdown"
				},
				"5": {
					"name": "meta.mapping.admonition.markdown"
				}
			},
			"end": "^(\\s*)(:{3,})\\s*$",
			"endCaptures": {
				"2": {
					"name": "punctuation.definition.admonition.markdown"
				}
			}
		},
		{
			"name": "keyword.control",
			"match": "^#\\s+(?i:РЕФЕРАТ|ОГЛАВЛЕНИЕ|ТЕРМИНЫ И ОПРЕДЕЛЕНИЯ|ПЕРЕЧЕНЬ СОКРАЩЕНИЙ И ОБОЗНАЧЕНИЙ|ВВЕДЕНИЕ|ЗАКЛЮЧЕНИЕ|СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ|ПРИЛОЖЕНИЯ)\\s*$"
		},
		{
			"comment": "!!(path){json}",
			"begin": "^(!!)(\\()([^{}]*)(\\))\\s*(?=\\{)",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.magic.markdown"
				},
				"2": {
					"name": "punctuation.definition.parameters.begin.markdown"
				},
				"3": {
					"name": "string.other.link.path.markdown"
				},
				"4": {
					"name": "punctuation.definition.parameters.end.markdown"
				}
			},
			"end": "(?<=\\})",
			"patterns": [
				{
					"include": "source.json"
				}
			]
		}
	]
}
